{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "black": "#191a2a",
    "background": "#222436",
    "red": "#ff757f",
    "green": "#c3e88d",
    "yellow": "#ffc777",
    "blue": "#82aaff",
    "purple": "#c099ff",
    "cyan": "#86e1fc",
    "white": "#c8d3f5",
    "brightBlack": "#828bb8",
    "brightRed": "#ff757f",
    "brightGreen": "#c3e88d",
    "brightYellow": "#ffc777",
    "brightBlue": "#82aaff",
    "brightPurple": "#c099ff",
    "brightCyan": "#86e1fc",
    "brightWhite": "#c8d3f5"
  },
  "console_title_template": "{{if .Root}}[root] {{end}}{{.Shell}} in <{{.Folder}}>",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "powerline",
          "foreground": "p:black",
          "background": "p:blue",
          "template": "{{ if .Root }}  ADMIN {{ else }}  {{ end }}",
          "background_templates": [
            "{{ if .Root }}p:red{{ end }}"
          ],
          "powerline_symbol": ""
        },
        {
          "type": "session",
          "style": "powerline",
          "foreground": "p:black",
          "background": "p:yellow",
          "template": "  {{ if .SSHSession }} {{ end }}{{ .UserName }}@{{ .HostName }} ",
          "powerline_symbol": ""
        },
        {
          "type": "path",
          "style": "powerline",
          "foreground": "p:black",
          "background": "p:purple",
          "template": "  {{ .Path }} ",
          "properties": {
            "style": "agnoster_short"
          },
          "powerline_symbol": ""
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:black",
          "background": "p:green",
          "template": "  {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "properties": {
            "cache_duration": "none",
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:red{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:yellow{{ end }}",
            "{{ if gt .Ahead 0 }}p:brightBlue{{ end }}",
            "{{ if gt .Behind 0 }}p:purple{{ end }}"
          ]
        },
        {
          "background": "#334155",
          "background_templates": [
            "{{ if gt .Code 0 }}p:brightRed{{ end }}"
          ],
          "foreground": "p:foreground",
          "options": {
            "always_enabled": true
          },
          "style": "powerline",
          "template": " {{ if gt .Code 0 }} {{ .Code }}{{ else }}{{ end }} ",
          "type": "status",
          "powerline_symbol": ""
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:brightCyan",
          "template": " {{ .CurrentDate | date .Format }}"
        },
        {
          "type": "shell",
          "style": "plain",
          "foreground": "p:brightCyan",
          "template": "  {{ .Name }}",
          "properties": {
            "cache_duration": "none"
          }
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:brightGreen",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:red{{ else if .Root }}p:yellow{{ end }}"
          ],
          "background": "transparent",
          "template": "{{ if .Root }}# {{ else }} {{ end }}",
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          }
        }
      ],
      "newline": true
    }
  ],
  "version": 3,
  "final_space": true
}